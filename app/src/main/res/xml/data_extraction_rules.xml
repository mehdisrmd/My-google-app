<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Block-log screenshots (#14) never leave the device. -->
        <exclude domain="file" path="blocklog/" />
    </cloud-backup>
    <device-transfer>
        <!-- Nor do they move to a new phone during setup transfer. -->
        <exclude domain="file" path="blocklog/" />
    </device-transfer>
</data-extraction-rules>
